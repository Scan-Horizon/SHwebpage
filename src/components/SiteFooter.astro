---
// Pied de page commun. Le lien « Supprimer mes donnees » reste toujours visible
// (exigence des stores et du RGPD).
import {
  CONTACT_EMAIL,
  LEGAL_ORDER,
  LEGAL_PAGES,
  STORE_LINKS,
  UI,
  legalPath,
  type Lang,
} from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const current = Astro.url.pathname;
const year = 2026;
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="col brand-col">
      <p class="tagline">{t.footerTagline}</p>
      <p class="company">© {year} SAS SCAN HORIZON</p>
    </div>

    <nav class="col" aria-labelledby="footer-app">
      <h2 id="footer-app" class="col-title">{t.footerApp}</h2>
      <ul>
        <li><a href={STORE_LINKS.ios} rel="noopener">App Store</a></li>
        <li><a href={STORE_LINKS.android} rel="noopener">Google Play</a></li>
      </ul>
    </nav>

    <nav class="col" aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="col-title">{t.footerLegal}</h2>
      <ul>
        {
          LEGAL_ORDER.map((key) => {
            const href = legalPath(key, lang);
            return (
              <li>
                <a
                  href={href}
                  class={key === 'delete' ? 'danger' : undefined}
                  aria-current={current === href ? 'page' : undefined}
                >
                  {LEGAL_PAGES[key][lang].navLabel}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="col">
      <h2 class="col-title">{t.footerContact}</h2>
      <p class="email">
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </div>
  <div class="wrap hud-line" aria-hidden="true">
    <span>SCANHORIZON TERMINAL</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--c-line);
    background: linear-gradient(180deg, transparent, rgba(10, 20, 38, 0.6));
    padding-block: var(--s-12) var(--s-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--s-8);
  }

  .col {
    min-width: 0;
  }

  .tagline {
    margin: 0 0 var(--s-2);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.3;
    text-wrap: balance;
  }

  .company {
    margin: 0;
    color: var(--c-ink-faint);
    font-size: 14px;
  }

  .col-title {
    margin: 0 0 var(--s-3);
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-2);
  }

  a {
    color: var(--c-ink-dim);
    text-decoration: none;
    font-size: 15px;
  }

  a:hover,
  a[aria-current='page'] {
    color: var(--c-ink);
  }

  a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--c-brand);
  }

  a.danger {
    color: var(--c-danger);
  }

  .email {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .hud-line {
    margin-top: var(--s-12);
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--c-ink-faint);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }

    .brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 420px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
