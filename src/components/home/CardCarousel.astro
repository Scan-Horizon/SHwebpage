---
// Carrousel de cartes en 3D (idee de Melen, prototype du 17 octobre 2026).
// Meme perspective que le Hangar de l'app : setEntry(3, 2, 0.001) puis rotateY,
// soit une perspective CSS de 1000 px. Glisser = pivoter, toucher = retourner.
// Le verso ne montre aucune compagnie inventee : il explique ce que l'app y affiche.
import { CARDS } from '../../data/home';
import { HOME } from '../../data/home';
import type { Lang } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME[lang].collection;
const items = [
  ...CARDS.map((c) => ({ ...c, label: t.rarities[c.key], event: false })),
  { key: 'event', img: '', aircraft: '', color: 'var(--c-rarity-event)', label: t.rarities.event, event: true },
];
const startIndex = 2;
---

<div class="carousel" data-carousel data-start={startIndex}>
  <div
    class="stage"
    tabindex="0"
    role="group"
    aria-roledescription={lang === 'fr' ? 'carrousel' : 'carousel'}
    aria-label={t.regionLabel}
  >
    <div class="track">
      {
        items.map((item, i) => (
          <div class="card" data-index={i} data-label={item.label} data-aircraft={item.aircraft} data-holo={item.key === 'epic' || item.key === 'legendary' ? '' : undefined}>
            <div class="spin">
              <div class="face front">
                {item.event ? (
                  <div class="event-front">
                    <span class="event-mark" aria-hidden="true">?</span>
                    <span class="event-name">{item.label}</span>
                  </div>
                ) : (
                  <img src={item.img} alt={`${item.label} : ${item.aircraft}`} width="812" height="1108" loading="lazy" decoding="async" draggable="false" />
                )}
                <div class="holo" />
                <div class="glare" />
                <div class="dim" />
              </div>
              <div class="face back" aria-hidden="true">
                {item.event ? (
                  <p class="event-back">{t.eventBack}</p>
                ) : (
                  <>
                    <div class="back-head">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z" />
                      </svg>
                      <span class="back-title">{t.backTitle}</span>
                      <span class="back-sub">{item.aircraft}</span>
                    </div>
                    <div class="slots">
                      {Array.from({ length: 8 }, () => <span />)}
                    </div>
                    <p class="back-text">{t.backText}</p>
                    <div class="goldbar" />
                  </>
                )}
                <div class="dim" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="floor" aria-hidden="true"></div>
  </div>

  <p class="sr-status visually-hidden" aria-live="polite" data-status></p>

  <div class="controls">
    <button type="button" class="ctrl" data-prev aria-label={t.prev}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <button type="button" class="ctrl primary" data-flip>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" /><path d="M3 21v-5h5" /></svg>
      {t.flip}
    </button>
    <button type="button" class="ctrl" data-next aria-label={t.next}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </div>

  <ul class="legend">
    {
      items.map((item, i) => (
        <li>
          <button type="button" data-goto={i} style={`--c:${item.color}`}>
            {item.label}
          </button>
        </li>
      ))
    }
  </ul>
  <p class="hint">{t.hint}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.card'));
    const spins = cards.map((c) => c.querySelector<HTMLElement>('.spin')!);
    const floor = root.querySelector<HTMLElement>('.floor')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const legend = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-goto]'));
    const N = cards.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const isFr = document.documentElement.lang === 'fr';

    let index = Number(root.dataset.start) || 0;
    let rot = 0, vel = 0, target = 0;
    let tiltX = 0, tiltY = 0, tiltTX = 0, tiltTY = 0;
    let glareX = 50, glareY = 30;
    let dragging = false, raf = 0, touched = false;

    const wrap = (o: number) => {
      let d = ((o % N) + N) % N;
      if (d > N / 2) d -= N;
      return d;
    };

    function layout() {
      const cw = cards[0].offsetWidth;
      cards.forEach((card, i) => {
        const o = wrap(i - index);
        const a = Math.abs(o);
        card.dataset.o = String(Math.min(a, 3));
        card.classList.toggle('is-center', o === 0);
        card.setAttribute('aria-hidden', o === 0 ? 'false' : 'true');
        let tr: string;
        if (o === 0) tr = 'translate3d(0,0,0)';
        else if (a === 1) tr = `translate3d(${o * cw * 0.74}px,0,-170px) rotateY(${-o * 38}deg)`;
        else if (a === 2) tr = `translate3d(${o * cw * 1.18}px,0,-360px) rotateY(${-o * 52}deg)`;
        else tr = `translate3d(${Math.sign(o) * cw * 1.4}px,0,-520px) rotateY(${-Math.sign(o) * 60}deg)`;
        card.style.transform = tr;
        if (o !== 0) {
          spins[i].classList.add('settle');
          spins[i].style.transform = 'translateZ(0px) rotateX(0deg) rotateY(0deg)';
        }
      });
      legend.forEach((b, i) => b.setAttribute('aria-current', i === index ? 'true' : 'false'));
      paint();
    }

    function announce() {
      const c = cards[index];
      const name = c.dataset.aircraft ? `, ${c.dataset.aircraft}` : '';
      status.textContent = `${index + 1} / ${N}, ${c.dataset.label}${name}`;
    }

    function goTo(i: number) {
      index = ((i % N) + N) % N;
      rot = vel = target = 0;
      tiltX = tiltY = tiltTX = tiltTY = 0;
      spins[index].classList.remove('settle');
      layout();
      announce();
    }

    function flip() {
      target = Math.round(target / 180) * 180 + 180;
      if (reduce) {
        rot = target;
        vel = 0;
      }
      const back = Math.cos((target * Math.PI) / 180) < 0;
      status.textContent = back ? (isFr ? 'Verso' : 'Back') : (isFr ? 'Recto' : 'Front');
      kick();
    }

    function paint() {
      const card = cards[index];
      const spin = spins[index];
      const s = Math.sin((rot * Math.PI) / 180);
      const lift = reduce ? 0 : 70 * Math.abs(s);
      spin.style.transform = `translateZ(${lift.toFixed(1)}px) rotateX(${tiltX.toFixed(2)}deg) rotateY(${(rot + tiltY).toFixed(2)}deg)`;
      const gx = fine && !dragging ? glareX : 50 - s * 45;
      card.style.setProperty('--gx', `${gx.toFixed(1)}%`);
      card.style.setProperty('--gy', `${(fine && !dragging ? glareY : 28).toFixed(1)}%`);
      card.style.setProperty('--hx', `${(50 + (rot + tiltY) * 0.8).toFixed(1)}%`);
      const side = Math.abs(Math.cos((rot * Math.PI) / 180));
      floor.style.setProperty('--fs', (0.55 + 0.45 * side).toFixed(3));
      floor.style.setProperty('--fo', (1 - lift / 140).toFixed(3));
    }

    function step() {
      raf = 0;
      if (!dragging) {
        if (reduce) {
          rot = target;
          vel = 0;
        } else {
          vel += (target - rot) * 0.075;
          vel *= 0.8;
          rot += vel;
        }
        if (Math.abs(target - rot) < 0.05 && Math.abs(vel) < 0.02) {
          rot = target;
          vel = 0;
        }
      }
      tiltX += (tiltTX - tiltX) * 0.14;
      tiltY += (tiltTY - tiltY) * 0.14;
      paint();
      const moving =
        dragging || rot !== target || Math.abs(tiltTX - tiltX) > 0.02 || Math.abs(tiltTY - tiltY) > 0.02;
      if (moving) raf = requestAnimationFrame(step);
    }

    function kick() {
      if (!raf) raf = requestAnimationFrame(step);
    }

    let startX = 0, startY = 0, startRot = 0, startT = 0, lastX = 0, lastT = 0, pv = 0, bgDrag = false;

    stage.addEventListener('pointerdown', (e) => {
      touched = true;
      const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
      startX = lastX = e.clientX;
      startY = e.clientY;
      startT = lastT = performance.now();
      pv = 0;
      if (card && card.classList.contains('is-center')) {
        dragging = true;
        startRot = rot;
        vel = 0;
        tiltTX = tiltTY = 0;
        card.classList.add('grabbing');
        stage.setPointerCapture(e.pointerId);
        kick();
      } else {
        bgDrag = !card;
      }
    });

    stage.addEventListener('pointermove', (e) => {
      if (dragging) {
        const now = performance.now();
        rot = startRot + (e.clientX - startX) * 0.5;
        pv = ((e.clientX - lastX) * 0.5) / Math.max(1, now - lastT);
        lastX = e.clientX;
        lastT = now;
        kick();
        return;
      }
      if (fine && !reduce) {
        const r = cards[index].getBoundingClientRect();
        const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
        if (inside) {
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          tiltTY = (px - 0.5) * 16;
          tiltTX = -(py - 0.5) * 12;
          glareX = px * 100;
          glareY = py * 100;
        } else {
          tiltTX = tiltTY = 0;
        }
        kick();
      }
    });

    stage.addEventListener('pointerup', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
      if (dragging) {
        dragging = false;
        cards[index].classList.remove('grabbing');
        const moved = Math.abs(e.clientX - startX);
        if (moved < 6 && performance.now() - startT < 320) {
          rot = startRot;
          flip();
        } else {
          target = Math.round((rot + pv * 220) / 180) * 180;
          vel = pv * 16;
          if (reduce) rot = target;
        }
        kick();
        return;
      }
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (card && !card.classList.contains('is-center') && Math.abs(dx) < 8) {
        goTo(Number(card.dataset.index));
        return;
      }
      if (bgDrag && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) goTo(index + (dx < 0 ? 1 : -1));
      bgDrag = false;
    });

    stage.addEventListener('pointercancel', () => {
      if (!dragging) return;
      dragging = false;
      cards[index].classList.remove('grabbing');
      target = Math.round(rot / 180) * 180;
      kick();
    });

    stage.addEventListener('pointerleave', () => {
      if (!dragging) {
        tiltTX = tiltTY = 0;
        kick();
      }
    });

    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(index - 1);
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        flip();
      }
    });

    root.querySelector('[data-prev]')!.addEventListener('click', () => goTo(index - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => goTo(index + 1));
    root.querySelector('[data-flip]')!.addEventListener('click', flip);
    legend.forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.goto))));
    window.addEventListener('resize', layout);
    layout();

    // Petit mouvement d'invite la premiere fois que le carrousel apparait a l'ecran.
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((en) => en.isIntersecting)) return;
          io.disconnect();
          setTimeout(() => {
            if (touched) return;
            target = 24;
            kick();
            setTimeout(() => {
              if (!touched) {
                target = 0;
                kick();
              }
            }, 520);
          }, 500);
        },
        { threshold: 0.6 },
      );
      io.observe(stage);
    }
  });
</script>

<style>
  .carousel {
    --cw: clamp(200px, 56vw, 300px);
    --ch: calc(var(--cw) * 1.3645);
    display: grid;
    justify-items: center;
    gap: var(--s-4);
    width: 100%;
  }

  .stage {
    position: relative;
    width: 100%;
    height: calc(var(--ch) + 64px);
    perspective: 1000px;
    perspective-origin: 50% 45%;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
    border-radius: var(--r-xl);
  }

  .stage:focus-visible {
    outline: 2px solid var(--c-brand);
    outline-offset: 4px;
  }

  .track {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .card {
    position: absolute;
    left: 50%;
    top: 18px;
    width: var(--cw);
    height: var(--ch);
    margin-left: calc(var(--cw) / -2);
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    cursor: pointer;
  }

  .card.is-center {
    z-index: 3;
    cursor: grab;
  }

  .card.is-center.grabbing {
    cursor: grabbing;
  }

  .card[data-o='3'] {
    opacity: 0;
    pointer-events: none;
  }

  .spin {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .spin.settle {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: calc(var(--cw) * 0.07);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .front img {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 30%), rgba(255, 255, 255, 0.36), transparent 46%);
    mix-blend-mode: soft-light;
  }

  .card.is-center .glare {
    opacity: 1;
  }

  .holo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: color-dodge;
    transition: opacity 0.3s;
    background: repeating-linear-gradient(115deg, #ff4d6a 0%, #ffd166 6%, #7cffcb 12%, #6e7eff 18%, #ff4d6a 24%);
    background-size: 300% 300%;
    background-position: var(--hx, 50%) 50%;
  }

  .card.is-center[data-holo] .holo {
    opacity: 0.16;
  }

  .dim {
    position: absolute;
    inset: 0;
    background: var(--c-night);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s;
  }

  .card[data-o='1'] .dim {
    opacity: 0.5;
  }

  .card[data-o='2'] .dim {
    opacity: 0.78;
  }

  /* Carte Evenement : silhouette, aucun indice */
  .event-front {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--s-4);
    background:
      repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.03) 0 2px, transparent 2px 6px),
      linear-gradient(160deg, #20232a, #15171b);
    border: 2px solid #9aa3b4;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }

  .event-mark {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: calc(var(--cw) * 0.42);
    line-height: 1;
    color: var(--c-rarity-event);
    text-shadow: 0 0 30px rgba(182, 198, 255, 0.45);
  }

  .event-name {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(var(--cw) * 0.06);
    color: #cbd2de;
  }

  /* Verso : plaque sombre et lisere or, comme le dos des cartes du Hangar */
  .back {
    transform: rotateY(180deg);
    display: flex;
    flex-direction: column;
    padding: calc(var(--cw) * 0.1) calc(var(--cw) * 0.08) 0;
    background: linear-gradient(135deg, #1c1c1e, #2c2c2e);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .back-head {
    display: grid;
    justify-items: center;
    gap: 6px;
    text-align: center;
  }

  .back-head svg {
    width: calc(var(--cw) * 0.08);
    height: calc(var(--cw) * 0.08);
    color: #d4af37;
  }

  .back-title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(var(--cw) * 0.045);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d4af37;
  }

  .back-sub {
    font-size: calc(var(--cw) * 0.042);
    color: rgba(255, 255, 255, 0.6);
  }

  .slots {
    margin-top: calc(var(--cw) * 0.08);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: calc(var(--cw) * 0.035);
  }

  .slots span {
    aspect-ratio: 1;
    border: 1px dashed rgba(212, 175, 55, 0.35);
    border-radius: calc(var(--cw) * 0.035);
  }

  .back-text {
    margin: calc(var(--cw) * 0.07) 0 0;
    text-align: center;
    font-size: calc(var(--cw) * 0.045);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.62);
  }

  .goldbar {
    margin-top: auto;
    margin-bottom: calc(var(--cw) * 0.06);
    height: 3px;
    background: #d4af37;
  }

  .event-back {
    margin: auto 0;
    text-align: center;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(var(--cw) * 0.07);
    line-height: 1.3;
    color: var(--c-rarity-event);
  }

  .floor {
    position: absolute;
    left: 50%;
    top: calc(var(--ch) + 28px);
    width: calc(var(--cw) * 0.9);
    height: 22px;
    margin-left: calc(var(--cw) * -0.45);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.6), transparent);
    transform: scaleX(var(--fs, 1));
    opacity: var(--fo, 1);
    pointer-events: none;
  }

  .controls {
    display: flex;
    gap: var(--s-2);
  }

  .ctrl {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 14px;
    font: 500 15px/1 var(--f-body);
    color: var(--c-ink);
    background: var(--c-panel);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    cursor: pointer;
  }

  .ctrl:hover {
    border-color: var(--c-brand);
  }

  .ctrl.primary {
    padding: 0 20px;
    background: var(--c-brand);
    border-color: var(--c-brand);
    color: var(--c-night);
    font-weight: 600;
  }

  .ctrl svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .legend button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 12px;
    font: 500 14px/1 var(--f-body);
    color: var(--c-ink-dim);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--r-pill);
    cursor: pointer;
  }

  .legend button::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c);
  }

  .legend button[aria-current='true'] {
    color: var(--c-ink);
    border-color: var(--c-line-strong);
  }

  .hint {
    margin: 0;
    font-size: 14px;
    color: var(--c-ink-faint);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .spin.settle {
      transition-duration: 0.01ms;
    }
  }
</style>
