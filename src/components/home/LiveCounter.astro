---
// Compteur « avions scannes » en direct, alimente par Railway (service diffusion,
// cache serveur de 5 min). Meme logique que l'ancien site, gardee telle quelle :
// appel direct d'abord, relais tiers seulement en secours. A simplifier quand
// Paulin aura confirme que scan-horizon.com est autorise (CORS_ALLOWED_ORIGINS).
interface Props {
  label: string;
  /** Petite mention « En direct » sous le chiffre. */
  live: string;
  lang: 'fr' | 'en';
}

const { label, live, lang } = Astro.props;
---

<p class="counter" data-live-counter data-lang={lang}>
  <span class="value" data-value aria-live="polite">&nbsp;</span>
  <span class="label">{label}</span>
  <span class="live"><span class="dot" aria-hidden="true"></span>{live}</span>
</p>

<script>
  const SCANS_URL = 'https://diffusion-api-production.up.railway.app/api/stats/scans-count';
  const CACHE_KEY = 'scan_horizon_scans_cache';
  const FALLBACK = 4589;

  function readCache(): number | null {
    try {
      const v = Number(localStorage.getItem(CACHE_KEY));
      return Number.isFinite(v) && v > 0 ? v : null;
    } catch {
      return null;
    }
  }

  function writeCache(v: number) {
    try {
      localStorage.setItem(CACHE_KEY, String(v));
    } catch {
      /* stockage indisponible : sans consequence */
    }
  }

  async function fetchWithTimeout(url: string, ms: number) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), ms);
    try {
      return await fetch(url, { signal: controller.signal, cache: 'no-store', mode: 'cors' });
    } finally {
      clearTimeout(timer);
    }
  }

  function firstJson(text: string) {
    const m = text.match(/\{[\s\S]*?\}/);
    if (!m) throw new Error('no json');
    return JSON.parse(m[0]);
  }

  async function readCount(url: string, ms: number): Promise<number> {
    const res = await fetchWithTimeout(url, ms);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const type = (res.headers.get('content-type') || '').toLowerCase();
    let data: any = type.includes('application/json') ? await res.json() : firstJson(await res.text());
    if (data && typeof data.contents === 'string') data = firstJson(data.contents);
    const n = Number(data?.total_scans_in_db);
    if (!Number.isFinite(n)) throw new Error('bad payload');
    return n;
  }

  async function loadCount(): Promise<number> {
    const bust = `cb=${Date.now()}`;
    const direct = `${SCANS_URL}?${bust}`;
    try {
      return await readCount(direct, 2500);
    } catch {
      const relays = [
        `https://api.codetabs.com/v1/proxy?quest=${encodeURIComponent(direct)}`,
        `https://api.allorigins.win/get?url=${encodeURIComponent(direct)}`,
        `https://r.jina.ai/http://${direct.replace(/^https?:\/\//, '')}`,
      ];
      return await Promise.any(relays.map((u) => readCount(u, 2200)));
    }
  }

  function render(el: HTMLElement, value: number, animate: boolean) {
    const locale = el.dataset.lang === 'en' ? 'en-US' : 'fr-FR';
    const target = el.querySelector<HTMLElement>('[data-value]');
    if (!target) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!animate || reduce) {
      target.textContent = value.toLocaleString(locale);
      return;
    }
    const start = performance.now();
    const from = Math.round(value * 0.92);
    const step = (now: number) => {
      const t = Math.min((now - start) / 900, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      target.textContent = Math.round(from + (value - from) * eased).toLocaleString(locale);
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  const counters = document.querySelectorAll<HTMLElement>('[data-live-counter]');
  const cached = readCache();
  counters.forEach((el) => render(el, cached ?? FALLBACK, false));

  loadCount()
    .then((n) => {
      writeCache(n);
      counters.forEach((el) => render(el, n, true));
    })
    .catch(() => {
      /* on garde la derniere valeur connue */
    });
</script>

<style>
  .counter {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .value {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(72px, 15vw, 176px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
    min-width: 4ch;
    background: linear-gradient(180deg, #ffffff 30%, #8fd6ff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .label {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(18px, 2.4vw, 26px);
    color: var(--c-ink);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--f-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3dffa0;
    box-shadow: 0 0 0 0 rgba(61, 255, 160, 0.6);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(61, 255, 160, 0.55);
    }
    100% {
      box-shadow: 0 0 0 10px rgba(61, 255, 160, 0);
    }
  }
</style>
