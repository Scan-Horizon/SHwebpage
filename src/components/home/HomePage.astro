---
// Accueil (FR et EN). Tout en haut, le compteur en tableau d'aeroport a palettes,
// sur toute la largeur ; puis la demo du scanner (on scanne pour de vrai). Ensuite
// le carrousel 3D, le globe des clans et la carte Business Class, reprise de l'app ;
// le reste reste sobre.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoreBadges from '../StoreBadges.astro';
import FlapBoard from './FlapBoard.astro';
import SkyScope from './SkyScope.astro';
import CardCarousel from './CardCarousel.astro';
import Globe from './Globe.astro';
import BusinessCard from './BusinessCard.astro';
import { HOME } from '../../data/home';
import { LEGAL_ORDER, LEGAL_PAGES, homePath, type Lang } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME[lang];
const other: Lang = lang === 'fr' ? 'en' : 'fr';

// Anciens liens de l'app et des e-mails (#privacy, #terms, #legal, #delete).
const legalRedirects = Object.fromEntries(
  LEGAL_ORDER.map((key) => [key, `/${lang}/${LEGAL_PAGES[key][lang].slug}/`]),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'ScanHorizon',
  url: `https://scan-horizon.com${homePath(lang)}`,
  operatingSystem: 'iOS, Android',
  applicationCategory: 'GameApplication',
  inLanguage: lang,
  description: t.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: { '@type': 'Organization', name: 'SAS SCAN HORIZON', url: 'https://scan-horizon.com/' },
};
---

<BaseLayout lang={lang} title={t.title} description={t.description} alternatePath={homePath(other)} home>
  <Fragment slot="head">
    <script is:inline define:vars={{ legalRedirects }}>
      (function () {
        var target = legalRedirects[window.location.hash.slice(1)];
        if (target) window.location.replace(target);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Le compteur, en tableau d'aeroport sur toute la largeur -->
  <section class="board-band" aria-label={t.hero.counterLabel}>
    <div class="wrap">
      <FlapBoard lang={lang} label={t.hero.counterLabel} live={t.hero.board.live} />
    </div>
  </section>

  <!-- Heros : la demo du scanner, avec les trois gestes qui s'allument au fil du scan -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{t.hero.h1}</h1>
        <p class="lead">{t.hero.lead}</p>
        <StoreBadges />
        <p class="rating">
          <span class="stars" aria-hidden="true"
            ><span class="stars-fill" style="width: 98%">★★★★★</span>★★★★★</span
          >
          {t.hero.rating}
        </p>
      </div>
      <div class="hero-demo">
        <SkyScope lang={lang} />
      </div>
      <ol class="hero-steps" aria-label={t.steps.h2}>
        {
          t.steps.items.map((s, i) => (
            <li data-demo-step={i + 1} class:list={[{ 'is-active': i === 0 }]}>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <span class="step-body">
                <strong>{s.title}</strong>
                <span>{s.text}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Collection : le carrousel 3D -->
  <section id="collection" class="collection" aria-labelledby="collection-title">
    <div class="wrap split">
      <div class="split-copy">
        <h2 id="collection-title">{t.collection.h2}</h2>
        {t.collection.text.map((p) => <p>{p}</p>)}
      </div>
      <CardCarousel lang={lang} />
    </div>
  </section>

  <!-- Progression -->
  <section class="progression" aria-labelledby="progression-title">
    <div class="wrap">
      <div class="narrow">
        <h2 id="progression-title">{t.progression.h2}</h2>
        <p>{t.progression.text}</p>
      </div>
      <ol class="levels">
        {
          Array.from({ length: 10 }, (_, i) => i + 1).map((level) => {
            const unlock = t.progression.unlocks.find((u) => u.level === level);
            return (
              <li class:list={[{ unlock: !!unlock }]}>
                <span class="lvl">
                  <span class="visually-hidden">{t.progression.levelWord} </span>
                  {level}
                </span>
                {unlock && <span class="what">{unlock.label}</span>}
              </li>
            );
          })
        }
      </ol>
      <p class="weekly">{t.progression.weekly}</p>
    </div>
  </section>

  <!-- Clans -->
  <section id="clans" class="clans" aria-labelledby="clans-title">
    <div class="wrap split reverse">
      <div class="split-copy">
        <h2 id="clans-title">{t.clans.h2}</h2>
        <p>{t.clans.text}</p>
      </div>
      <Globe label={t.clans.globeLabel} hint={t.clans.globeHint} />
    </div>
  </section>

  <!-- Le reste de l'app -->
  <section class="features" aria-labelledby="features-title">
    <div class="wrap">
      <h2 id="features-title">{t.features.h2}</h2>
      <dl class="feature-list">
        {
          t.features.items.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Avis -->
  <section class="reviews" aria-labelledby="reviews-title">
    <div class="wrap">
      <h2 id="reviews-title">{t.reviews.h2}</h2>
      <div class="quotes">
        {
          t.reviews.items.map((r) => (
            <figure>
              <blockquote>
                <p>{r.quote}</p>
              </blockquote>
              <figcaption>
                {r.author}, {t.reviews.source}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Business Class -->
  <section id="business" class="business" aria-labelledby="business-title">
    <div class="wrap business-inner">
      <div class="business-copy">
        <h2 id="business-title">{t.business.h2}</h2>
        <p class="business-lead">{t.business.lead}</p>
      </div>
      <div class="business-card">
        <BusinessCard lang={lang} />
      </div>
      <div class="business-perks">
        <ul class="perks">
          {t.business.items.map((item) => <li>{item}</li>)}
        </ul>
        <p class="business-note">{t.business.note}</p>
      </div>
    </div>
  </section>

  <!-- Telecharger -->
  <section id="telecharger" class="cta" aria-labelledby="cta-title">
    <div class="wrap cta-inner">
      <div>
        <h2 id="cta-title">{t.cta.h2}</h2>
        <p>{t.cta.text}</p>
        <StoreBadges />
      </div>
      <figure class="qr">
        <img src={`/img/qr-${lang}.svg`} alt="" width="160" height="160" loading="lazy" />
        <figcaption>{t.cta.qr}</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  h2 {
    margin: 0 0 var(--s-4);
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(30px, 4.2vw, 48px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  section p {
    color: var(--c-ink-dim);
    font-size: 18px;
    line-height: 1.6;
  }

  section > .wrap {
    padding-block: clamp(64px, 9vw, 120px);
  }

  .narrow,
  .split-copy {
    max-width: 34rem;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .split.reverse {
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
  }

  .split.reverse .split-copy {
    order: 2;
  }

  .split.reverse .globe {
    justify-self: center;
  }

  /* Heros */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 70% at 75% 0%, rgba(23, 59, 107, 0.55), transparent 60%),
      linear-gradient(180deg, #050a15, #050a15);
    border-bottom: 1px solid var(--c-line);
  }

  .hero .wrap {
    padding-block: clamp(32px, 4vw, 56px) clamp(48px, 6vw, 80px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas:
      'copy demo'
      'steps steps';
    column-gap: clamp(32px, 5vw, 64px);
    row-gap: var(--s-8);
    align-items: center;
  }

  /* Le texte part du haut (et non du centre de la demo) : titre et boutons restent au
     premier ecran meme sur un portable peu haut, sous le tableau. */
  .hero-copy {
    grid-area: copy;
    align-self: start;
    padding-top: clamp(0px, 2.5vw, 40px);
  }

  .hero-demo {
    grid-area: demo;
  }

  /* Les trois gestes, en bandeau sous le heros : celui en cours s'allume pendant la demo */
  .hero-steps {
    grid-area: steps;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .hero-steps li {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: var(--s-3);
    align-items: start;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    border: 1px solid transparent;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .hero-steps li.is-active {
    background: rgba(56, 182, 255, 0.08);
    border-color: var(--c-line-strong);
  }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--c-line-strong);
    color: var(--c-ink-dim);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .is-active .step-num {
    border-color: var(--c-brand);
    background: var(--c-brand);
    color: var(--c-night);
  }

  .step-body {
    display: grid;
    gap: 2px;
  }

  .step-body strong {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 17px;
    color: var(--c-ink-dim);
    transition: color 0.3s ease;
  }

  .is-active .step-body strong {
    color: var(--c-ink);
  }

  .step-body span {
    font-size: 14px;
    line-height: 1.45;
    color: var(--c-ink-faint);
  }

  .is-active .step-body span {
    color: var(--c-ink-dim);
  }

  h1 {
    margin: 0 0 var(--s-6);
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(40px, min(6.4vw, 9.5svh), 72px);
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .lead {
    margin: 0 0 var(--s-6);
    max-width: 34rem;
    font-size: clamp(17px, 1.5vw, 20px);
  }

  /* Le tableau a palettes, en bandeau sous le menu */
  .board-band {
    background: linear-gradient(180deg, #0b1526, #070e1b);
    border-bottom: 1px solid var(--c-line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .board-band > .wrap {
    padding-block: clamp(16px, 2.2vw, 28px);
  }

  .rating {
    margin: var(--s-4) 0 0;
    font-size: 15px;
    color: var(--c-ink-dim);
  }

  .stars {
    position: relative;
    display: inline-block;
    color: rgba(255, 209, 102, 0.28);
    letter-spacing: 2px;
    margin-right: 6px;
  }

  .stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    overflow: hidden;
    white-space: nowrap;
    color: #ffd166;
  }

  /* Collection */
  .collection {
    background: linear-gradient(180deg, transparent, rgba(10, 20, 38, 0.7) 30%, rgba(10, 20, 38, 0.7) 70%, transparent);
  }

  .collection .split-copy p:last-child {
    color: var(--c-rarity-event);
  }

  /* Progression */
  .levels {
    list-style: none;
    margin: var(--s-12) 0 var(--s-6);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    position: relative;
  }

  .levels::before {
    content: '';
    position: absolute;
    left: 5%;
    right: 5%;
    top: 21px;
    height: 2px;
    background: linear-gradient(90deg, var(--c-brand), rgba(56, 182, 255, 0.15));
  }

  .levels li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    text-align: center;
  }

  .lvl {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-night);
    border: 1px solid var(--c-line-strong);
    font-family: var(--f-display);
    font-weight: 700;
    color: var(--c-ink-dim);
  }

  .unlock .lvl {
    border-color: var(--c-brand);
    color: var(--c-ink);
    box-shadow: 0 0 0 4px rgba(56, 182, 255, 0.12);
  }

  .what {
    font-size: 14px;
    line-height: 1.3;
    color: var(--c-ink);
    max-width: 11ch;
  }

  .weekly {
    margin: 0;
  }

  /* Fonctionnalites : une liste, pas des cartes */
  .feature-list {
    margin: var(--s-8) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-8) var(--s-8);
  }

  .feature-list > div {
    border-top: 1px solid var(--c-line);
    padding-top: var(--s-4);
  }

  .feature-list dt {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 19px;
    margin-bottom: var(--s-2);
  }

  .feature-list dd {
    margin: 0;
    color: var(--c-ink-dim);
  }

  /* Avis */
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
    margin-top: var(--s-6);
  }

  .quotes figure {
    margin: 0;
  }

  .quotes blockquote {
    margin: 0;
  }

  .quotes blockquote p {
    margin: 0 0 var(--s-3);
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.2;
    color: var(--c-ink);
  }

  .quotes figcaption {
    color: var(--c-ink-faint);
    font-size: 15px;
  }

  /* Business Class : la seule touche doree de la page */
  .business {
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(230, 197, 106, 0.12), transparent 60%),
      #0b0d12;
    border-block: 1px solid rgba(230, 197, 106, 0.25);
  }

  .business-inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    grid-template-areas:
      'copy card'
      'perks card';
    grid-template-rows: auto 1fr;
    column-gap: clamp(32px, 6vw, 96px);
    row-gap: var(--s-6);
    align-items: start;
  }

  .business-copy {
    grid-area: copy;
  }

  .business-card {
    grid-area: card;
    align-self: center;
    display: grid;
  }

  .business-perks {
    grid-area: perks;
  }

  .business h2 {
    color: var(--c-business-gold);
  }

  .business-lead {
    margin: 0;
    color: var(--c-ink);
  }

  .business-note {
    margin: var(--s-4) 0 0;
    font-size: 15px;
    color: var(--c-ink-faint);
  }

  .perks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .perks li {
    padding: var(--s-4) 0 var(--s-4) var(--s-8);
    border-bottom: 1px solid rgba(230, 197, 106, 0.18);
    font-size: 18px;
    position: relative;
  }

  .perks li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    transform: rotate(45deg);
    border: 2px solid var(--c-business-gold);
  }

  /* Telecharger */
  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-12);
    align-items: center;
  }

  .cta h2 {
    font-size: clamp(42px, 7vw, 88px);
    letter-spacing: -0.03em;
  }

  .cta p {
    margin: 0 0 var(--s-6);
  }

  .qr {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
    max-width: 200px;
    text-align: center;
  }

  .qr img {
    width: 160px;
    height: 160px;
    padding: 10px;
    background: #fff;
    border-radius: var(--r-md);
  }

  .qr figcaption {
    font-size: 14px;
    color: var(--c-ink-faint);
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'copy'
        'demo'
        'steps';
      row-gap: var(--s-8);
    }

    .hero-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
      max-width: 34rem;
    }

    .split,
    .split.reverse,
    .cta-inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .business-inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'copy'
        'card'
        'perks';
      grid-template-rows: auto;
      row-gap: var(--s-8);
    }

    .split.reverse .split-copy {
      order: 0;
    }

    .feature-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .qr {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .quotes {
      grid-template-columns: minmax(0, 1fr);
    }

    .levels {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }

    .levels::before {
      left: 21px;
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--c-brand), rgba(56, 182, 255, 0.15));
    }

    .levels li {
      grid-template-columns: 44px 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
    }

    .levels li:not(.unlock) {
      display: none;
    }

    .levels li:first-child,
    .levels li:last-child {
      display: grid;
    }

    /* Les niveaux 6 a 9 sont masques sur mobile : un espace marque le saut. */
    .levels li:last-child {
      margin-top: var(--s-6);
    }

    .what {
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    .feature-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
