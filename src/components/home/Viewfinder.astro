---
// Moment fort de l'accueil : le viseur de l'app suit un avion dans le ciel de nuit,
// le verrouille, puis sa carte apparait. Animation 100 % CSS, en boucle de 10 s.
// Si le systeme demande moins d'animations, on affiche directement l'etat final.
interface Props {
  label: string;
  locked: string;
  identified: string;
}

const { label, locked, identified } = Astro.props;
---

<figure class="vf" role="img" aria-label={label}>
  <div class="phone" aria-hidden="true">
    <div class="screen">
      <div class="stars"></div>
      <div class="horizon"></div>

      <div class="tape">
        <div class="tape-track">
          <span>045</span><span>060</span><span>075</span><span>090</span><span>105</span><span>120</span>
        </div>
        <span class="caret"></span>
      </div>

      <div class="crosshair"></div>

      <div class="target">
        <svg class="plane" viewBox="0 0 64 24">
          <path
            d="M2 13.2c0-1 .8-1.6 2-1.6h20.5L37 3.2c.6-.4 1.2-.6 1.9-.6h2.4l-6 9h16.8l4.9-5.4h3.1l-2.3 6.2c1.6.4 2.8 1 2.8 1.9s-1.2 1.5-2.8 1.9l2.3 6.2h-3.1l-4.9-5.4H35.3l6 9h-2.4c-.7 0-1.3-.2-1.9-.6L24.5 14.9H4c-1.2 0-2-.6-2-1.7z"
          ></path>
        </svg>
        <span class="light red"></span>
        <span class="light green"></span>
        <span class="light strobe"></span>
        <span class="box"><i></i><i></i><i></i><i></i></span>
        <span class="lock-label">{locked}</span>
      </div>

      <div class="readout">
        <span class="readout-name">{identified}</span>
      </div>

      <img class="card" src="/common.webp" alt="" width="812" height="1108" decoding="async" fetchpriority="high" />
    </div>
  </div>
  <div class="glow" aria-hidden="true"></div>
</figure>

<style>
  .vf {
    position: relative;
    margin: 0;
    display: grid;
    place-items: center;
  }

  .glow {
    position: absolute;
    inset: 8% -10% 0;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(56, 182, 255, 0.22), transparent 70%);
    filter: blur(10px);
  }

  .phone {
    width: min(330px, 68vw);
    aspect-ratio: 9 / 19;
    padding: 10px;
    border-radius: 46px;
    background: linear-gradient(160deg, #1a2333, #070b14 60%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 40px 80px rgba(0, 0, 0, 0.55),
      inset 0 0 0 1px rgba(0, 0, 0, 0.6);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 36px;
    background: linear-gradient(180deg, #01030a 0%, #04112a 46%, #0b2550 80%, #173b6b 100%);
    container-type: inline-size;
  }

  /* Ciel */
  .stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 12% 18%, #fff 60%, transparent),
      radial-gradient(1px 1px at 28% 9%, #cfe6ff 60%, transparent),
      radial-gradient(1.4px 1.4px at 71% 14%, #fff 60%, transparent),
      radial-gradient(1px 1px at 86% 31%, #cfe6ff 60%, transparent),
      radial-gradient(1px 1px at 44% 27%, #fff 60%, transparent),
      radial-gradient(1px 1px at 58% 6%, #fff 60%, transparent),
      radial-gradient(1px 1px at 9% 41%, #cfe6ff 60%, transparent),
      radial-gradient(1.2px 1.2px at 92% 52%, #fff 60%, transparent),
      radial-gradient(1px 1px at 35% 58%, #9fc4ee 60%, transparent),
      radial-gradient(1px 1px at 66% 47%, #9fc4ee 60%, transparent);
    opacity: 0.85;
  }

  .horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 9%;
    background:
      radial-gradient(2px 2px at 8% 40%, #ffd28a 60%, transparent),
      radial-gradient(2px 2px at 19% 55%, #ffe3b0 60%, transparent),
      radial-gradient(2px 2px at 33% 35%, #ffd28a 60%, transparent),
      radial-gradient(2px 2px at 47% 60%, #fff1d6 60%, transparent),
      radial-gradient(2px 2px at 61% 42%, #ffd28a 60%, transparent),
      radial-gradient(2px 2px at 78% 58%, #ffe3b0 60%, transparent),
      radial-gradient(2px 2px at 90% 38%, #ffd28a 60%, transparent),
      linear-gradient(180deg, #050b17, #02050c);
  }

  /* HUD : bande de cap */
  .tape {
    position: absolute;
    top: 7%;
    left: 10%;
    right: 10%;
    height: 34px;
    overflow: hidden;
    border-bottom: 1px solid rgba(143, 214, 255, 0.35);
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }

  .tape-track {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    gap: 0;
    width: 160%;
    height: 100%;
    background: repeating-linear-gradient(90deg, rgba(143, 214, 255, 0.55) 0 1px, transparent 1px 10cqw);
    background-size: 100% 6px;
    background-repeat: repeat-x;
    background-position: bottom;
    animation: tape 10s linear infinite;
  }

  .tape-track span {
    flex: 1;
    padding-top: 4px;
    text-align: left;
    font-family: var(--f-mono);
    font-size: 10px;
    color: #8fd6ff;
  }

  .caret {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 0;
    margin-left: -5px;
    border: 5px solid transparent;
    border-bottom-color: #8fd6ff;
  }

  .crosshair {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 46px;
    height: 46px;
    margin: -23px 0 0 -23px;
    background:
      linear-gradient(#8fd6ff, #8fd6ff) center / 1px 12px no-repeat,
      linear-gradient(#8fd6ff, #8fd6ff) center / 12px 1px no-repeat;
    border: 1px solid rgba(143, 214, 255, 0.28);
    border-radius: 50%;
    opacity: 0.7;
  }

  /* Avion et verrouillage */
  .target {
    position: absolute;
    top: 44%;
    left: 0;
    width: 18cqw;
    aspect-ratio: 64 / 24;
    margin-top: -3.4cqw;
    animation: fly 10s linear infinite;
  }

  .plane {
    width: 100%;
    height: 100%;
    fill: #5d7ea8;
    filter: drop-shadow(0 0 5px rgba(143, 214, 255, 0.35));
    /* Le dessin a le nez a gauche : on le retourne pour qu'il vole vers la droite. */
    transform: scaleX(-1);
  }

  .light {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
  }

  .light.red {
    left: 36%;
    top: 4%;
    background: #ff4d5e;
    box-shadow: 0 0 6px #ff4d5e;
    animation: blink 1.2s steps(2, jump-none) infinite;
  }

  .light.green {
    left: 36%;
    bottom: 4%;
    background: #3dffa0;
    box-shadow: 0 0 6px #3dffa0;
    animation: blink 1.2s steps(2, jump-none) infinite 0.6s;
  }

  .light.strobe {
    left: -2px;
    top: 50%;
    background: #fff;
    box-shadow: 0 0 10px 2px #fff;
    animation: strobe 1.6s linear infinite;
  }

  .box {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    color: rgba(232, 241, 251, 0.75);
    animation: lock 10s ease-in-out infinite;
  }

  .box i {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: currentColor;
    border-style: solid;
  }

  .box i:nth-child(1) {
    left: 0;
    top: 0;
    border-width: 2px 0 0 2px;
  }

  .box i:nth-child(2) {
    right: 0;
    top: 0;
    border-width: 2px 2px 0 0;
  }

  .box i:nth-child(3) {
    left: 0;
    bottom: 0;
    border-width: 0 0 2px 2px;
  }

  .box i:nth-child(4) {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
  }

  .lock-label {
    position: absolute;
    left: 50%;
    top: calc(50% + 38px);
    transform: translateX(-50%);
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-brand);
    white-space: nowrap;
    opacity: 0;
    animation: label 10s ease-in-out infinite;
  }

  .readout {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 58%;
    display: flex;
    justify-content: center;
    opacity: 0;
    animation: readout 10s ease-in-out infinite;
  }

  .readout-name {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--c-ink);
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgba(5, 10, 21, 0.72);
    border: 1px solid rgba(56, 182, 255, 0.4);
  }

  .card {
    position: absolute;
    left: 50%;
    bottom: 5%;
    width: 64%;
    height: auto;
    margin-left: -32%;
    transform-origin: 50% 100%;
    filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.6));
    animation: card 10s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  /* En unites du conteneur (cqw) : l'avion arrive sous le reticule au moment du
     verrouillage (40 % de la boucle), quelle que soit la largeur du telephone.
     Ensuite le viseur le suit (il derive a peine), puis il s'efface avec la carte. */
  @keyframes fly {
    0% {
      transform: translateX(-20cqw);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.35, 1);
    }
    40% {
      transform: translateX(41cqw);
    }
    90% {
      transform: translateX(46cqw);
      opacity: 1;
    }
    100% {
      transform: translateX(52cqw);
      opacity: 0;
    }
  }

  @keyframes tape {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-25%);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0.15;
    }
  }

  @keyframes strobe {
    0%,
    8% {
      opacity: 1;
    }
    12%,
    100% {
      opacity: 0;
    }
  }

  @keyframes lock {
    0%,
    10% {
      transform: scale(2.4);
      opacity: 0;
      color: rgba(232, 241, 251, 0.7);
    }
    18% {
      transform: scale(2);
      opacity: 1;
    }
    34% {
      transform: scale(1.5);
      color: rgba(232, 241, 251, 0.75);
    }
    40% {
      transform: scale(1);
      color: var(--c-brand);
    }
    44% {
      transform: scale(1.12);
    }
    48%,
    88% {
      transform: scale(1);
      opacity: 1;
      color: var(--c-brand);
    }
    94%,
    100% {
      transform: scale(1);
      opacity: 0;
      color: var(--c-brand);
    }
  }

  @keyframes label {
    0%,
    40% {
      opacity: 0;
    }
    44%,
    88% {
      opacity: 1;
    }
    94%,
    100% {
      opacity: 0;
    }
  }

  @keyframes readout {
    0%,
    46% {
      opacity: 0;
      transform: translateY(6px);
    }
    50%,
    56% {
      opacity: 1;
      transform: translateY(0);
    }
    60%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @keyframes card {
    0%,
    54% {
      opacity: 0;
      transform: perspective(900px) translateY(40%) rotateY(-80deg) scale(0.9);
    }
    64% {
      opacity: 1;
      transform: perspective(900px) translateY(0) rotateY(0deg) scale(1);
    }
    90% {
      opacity: 1;
      transform: perspective(900px) translateY(0) rotateY(0deg) scale(1);
    }
    97%,
    100% {
      opacity: 0;
      transform: perspective(900px) translateY(8%) rotateY(0deg) scale(0.96);
    }
  }

  /* Moins d'animations : on montre l'avion verrouille et sa carte, sans mouvement. */
  @media (prefers-reduced-motion: reduce) {
    .target,
    .tape-track,
    .box,
    .lock-label,
    .readout,
    .card,
    .light {
      animation: none !important;
    }

    .target {
      transform: translateX(41cqw);
    }

    .box {
      color: var(--c-brand);
    }

    .lock-label {
      opacity: 1;
    }

    .card {
      opacity: 1;
      transform: none;
    }
  }
</style>
