  .grid-inner,
  .traffic {
    transition: opacity 0.35s ease;
  }

  .scope:is([data-state='scanning'], [data-state='caught'], [data-state='result']) :is(.grid-inner, .traffic) {
    opacity: 0;
  }

  /* Animations de l'app, au centre de l'instrument */
  .overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 44%;
    height: 44%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .scope:is([data-state='scanning'], [data-state='caught']) .overlay {
    opacity: 1;
  }

  /* Carte obtenue : apparait au centre, la ou tournait l'animation */
  .scrim {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(4, 9, 19, 0.82), rgba(4, 9, 19, 0.6));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .scope[data-state='result'] .scrim {
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
  }

  .result {
    position: absolute;
    left: var(--fx, 50%);
    top: var(--fy, 50%);
    width: 40%;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 8px;
    opacity: 0;
    transform: translate(-50%, -50%) perspective(900px) rotateY(-110deg) scale(0.12);
