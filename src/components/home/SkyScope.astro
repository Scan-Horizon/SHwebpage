  .scope :global(.tag text) {
    font-family: var(--f-mono);
    font-size: calc(10.5px * var(--u));
    paint-order: stroke;
    stroke: rgba(4, 11, 24, 0.85);
    stroke-width: calc(3px * var(--u));
    stroke-linejoin: round;
  }

  .scope :global(.tag) {
    transition: opacity 0.3s ease;
  }

  .scope :global(.edge .tag) {
    opacity: 0;
  }

  .scope :global(.t1) {
    fill: #e8f1fb;
    font-weight: 500;
  }

  .scope :global(.t2) {
    fill: rgba(143, 214, 255, 0.7);
  }

  .scope :global(.plane) {
    transition: opacity 0.25s ease;
  }

  /* Viseur et cadre */
  .reticle circle {
    fill: none;
    stroke: rgba(143, 214, 255, 0.7);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .reticle path {
    stroke: #8fd6ff;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .reticle {
    transition: opacity 0.2s ease;
