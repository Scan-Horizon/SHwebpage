    top: 49%;
    opacity: 1;
    transform: translate(-50%, -50%) perspective(900px) rotateY(0deg) scale(1);
    pointer-events: auto;
    cursor: pointer;
    transition:
      left 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      top 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease;
  }

  .result img {
    width: 100%;
    height: auto;
    border-radius: 10px;
