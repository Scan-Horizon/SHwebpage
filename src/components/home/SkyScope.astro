    font-weight: 500;
    fill: #8fd6ff;
  }

  .cardinal.north {
    fill: var(--c-ink);
  }

  .deg {
    font-size: calc(9.5px * var(--u));
    fill: rgba(143, 214, 255, 0.5);
  }

  .elev {
    font-size: calc(9.5px * var(--u));
    fill: rgba(143, 214, 255, 0.42);
  }

  /* Avions (crees par le script : styles globaux sous .scope) */
  .scope :global(.shape) {
    fill: #eef5ff;
  }

  .scope :global(.trail) {
    opacity: 0.55;
  }

  .scope :global(.rotor) {
    transform-box: fill-box;
    transform-origin: center;
    animation: rotor 0.35s linear infinite;
  }

  .scope :global(.rotor rect) {
    opacity: 0.8;
  }

  .scope :global(.rotor-disc) {
    fill: rgba(238, 245, 255, 0.08);
  }

  .scope :global(.tag) {
    transform: translate(calc(16px * var(--u)), calc(-14px * var(--u)));
