  }

  .result figcaption {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }

  .pill {
    padding: 3px 10px;
    border-radius: var(--r-pill);
    border: 1px solid var(--c, var(--c-brand));
    color: var(--c, var(--c-brand));
    background: rgba(5, 10, 21, 0.75);
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .name {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(12px, 2.6vw, 15px);
    color: var(--c-ink);
    white-space: nowrap;
  }

  /* Bouton Scan de l'app, pose a cheval sur le bord du ciel */
  .scan-btn {
    position: relative;
    z-index: 2;
    width: var(--btn);
    height: var(--btn);
    margin-top: calc(var(--btn) / -2);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .scan-btn:disabled {
    cursor: progress;
  }

  .scan-btn:focus-visible {
    outline-offset: 4px;
    border-radius: 50%;
  }

  .btn-face {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #14213d;
    border: 2.5px solid #9fb9e8;
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.45),
      0 2px 4px rgba(0, 0, 0, 0.28);
    transition: transform 0.12s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .scan-btn:active:not(:disabled) .btn-face {
