---
// La carte Business Class de l'app, refaite en HTML pour rester nette partout.
// Source : lib/widgets/premium/business_class_card.dart (face « membre ») et les
// couleurs BusinessCardPalette.gold de lib/theme/tokens_context.dart :
// - format carte bancaire (largeur / 1,586), coins a 5 % de la largeur ;
// - face : degrade D6C99A, DFD9B9, CAB36C, E1D5A6, BA9A4C ; encre 3A2B0A, 8D6A1F ;
// - puce E6CFA1 vers D4AF37, liseré FFF2BF, halo E6C56A, reflet qui suit l'inclinaison ;
// - dos : « Avantages Business Class » et la liste des avantages (memes icones).
// Elle s'incline avec la souris et se retourne au clic, comme dans l'app.
import { HOME } from '../../data/home';
import type { Lang } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME[lang].business;
const year = new Date().getFullYear();

// Icones Material de l'app, dans l'ordre de PremiumBenefits.all.
const icons = [
  // all_inclusive_rounded
  'M18.6 6.62c-1.44 0-2.8.56-3.77 1.53L12 10.66 10.48 12h.01L7.8 14.39c-.64.64-1.49.99-2.4.99-1.87 0-3.39-1.51-3.39-3.38S3.53 8.62 5.4 8.62c.91 0 1.76.35 2.44 1.03l1.13 1 1.51-1.34L9.22 8.2C8.2 7.18 6.84 6.62 5.4 6.62 2.42 6.62 0 9.04 0 12s2.42 5.38 5.4 5.38c1.44 0 2.8-.56 3.77-1.53l2.83-2.5.01.01L13.52 12h-.01l2.69-2.39c.64-.64 1.49-.99 2.4-.99 1.87 0 3.39 1.51 3.39 3.38s-1.52 3.38-3.39 3.38c-.9 0-1.76-.35-2.44-1.03l-1.14-1.01-1.51 1.34 1.27 1.12c1.02 1.01 2.37 1.57 3.82 1.57 2.98 0 5.4-2.41 5.4-5.38s-2.42-5.37-5.4-5.37z',
  // radar_rounded (anneaux concentriques)
  'M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 1 1 0-16zm0 2a6 6 0 1 0 0 12 6 6 0 1 0 0-12zm0 2a4 4 0 1 1 0 8 4 4 0 1 1 0-8zm0 2.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 1 0 0-3z',
  // bolt_rounded
  'M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21z',
  // auto_awesome_rounded
  'M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z',
  // workspace_premium_rounded
  'M9.68 13.69 12 11.93l2.31 1.76-.88-2.85L15.75 9h-2.84L12 6.19 11.09 9H8.25l2.31 1.84-.88 2.85zM20 10c0-4.42-3.58-8-8-8s-8 3.58-8 8c0 2.03.76 3.87 2 5.28V23l6-2 6 2v-7.72A7.96 7.96 0 0 0 20 10zm-8-6c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6 2.69-6 6-6z',
];
---

<div class="bc-wrap" data-bc>
  <button type="button" class="bc" aria-pressed="false" aria-label={t.card.flip} data-bc-card>
    <span class="bc-tilt" data-bc-tilt>
      <span class="bc-spin" data-bc-spin>
        <span class="face front" aria-hidden="true">
          <span class="row top">
            <span class="chip">
              <svg viewBox="0 0 26 20" preserveAspectRatio="none">
                <path d="M0 6h26M0 14h26M7.8 0v20M18.2 0v20"></path>
                <rect x="8.45" y="5.5" width="9.1" height="9" rx="2.6"></rect>
              </svg>
            </span>
            <svg class="plane" viewBox="0 0 24 24">
              <path d="M22 16v-2l-8.5-5V3.5c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5V9L2 14v2l8.5-2.5V19L8 20.5V22l4-1 4 1v-1.5L13.5 19v-5.5L22 16z"></path>
            </svg>
          </span>
          <span class="number">**** **** **** {year}</span>
          <span class="row bottom">
            <span class="field">
              <span class="label">{t.card.memberLabel}</span>
              <span class="member">{t.card.memberName}</span>
            </span>
            <span class="field right">
              <span class="label">{t.card.statusLabel}</span>
              <span class="status">BUSINESS CLASS</span>
            </span>
          </span>
          <span class="sheen"></span>
        </span>

        <span class="face back" aria-hidden="true">
          <span class="back-title">{t.card.benefitsTitle}</span>
          <span class="benefits">
            {
              t.items.map((item, i) => (
                <span class="benefit">
                  <svg viewBox="0 0 24 24">
                    <path d={icons[i]} fill-rule="evenodd" />
                  </svg>
                  <span>{item}</span>
                </span>
              ))
            }
          </span>
          <span class="sheen"></span>
        </span>
      </span>
    </span>
  </button>
  <p class="bc-hint">{t.card.hint}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-bc]').forEach((root) => {
    const card = root.querySelector<HTMLButtonElement>('[data-bc-card]')!;
    const tilt = root.querySelector<HTMLElement>('[data-bc-tilt]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    let flipped = false;

    // Reflet et ombre suivent l'inclinaison, comme le gyroscope dans l'app.
    function setTilt(x: number, y: number) {
      tilt.style.setProperty('--x', x.toFixed(3));
      tilt.style.setProperty('--y', y.toFixed(3));
    }

    card.addEventListener('click', () => {
      flipped = !flipped;
      root.classList.toggle('flipped', flipped);
      card.setAttribute('aria-pressed', flipped ? 'true' : 'false');
    });

    if (fine && !reduce) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        setTilt(((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1);
      });
      card.addEventListener('pointerleave', () => setTilt(0, 0));
    }

    // Une esquisse de mouvement a l'apparition, pour montrer que la carte se manipule.
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        root.classList.add('peek');
        window.setTimeout(() => root.classList.remove('peek'), 1600);
      }, { threshold: 0.6 });
      io.observe(card);
    }
  });
</script>

<style>
  .bc-wrap {
    width: min(440px, 100%);
    container-type: inline-size;
    justify-self: center;
  }

  .bc {
    display: block;
    width: 100%;
    aspect-ratio: 1.586;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    perspective: 1000px;
    font: inherit;
    color: inherit;
    border-radius: 5cqw;
    -webkit-tap-highlight-color: transparent;
  }

  .bc:focus-visible {
    outline-offset: 6px;
  }

  .bc-tilt {
    --x: 0;
    --y: 0;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--x) * 12deg)) rotateX(calc(var(--y) * -10deg));
    transition: transform 0.25s ease-out;
  }

  .bc-spin {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .flipped .bc-spin {
    transform: rotateY(180deg);
  }

  .peek .bc-spin {
    animation: peek 1.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 7cqw;
    border-radius: 5cqw;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    background: linear-gradient(135deg, #d6c99a, #dfd9b9, #cab36c, #e1d5a6, #ba9a4c);
    color: #3a2b0a;
    text-align: left;
    box-shadow:
      inset 0 0 0 1px rgba(255, 242, 191, 0.45),
      calc(var(--x) * -10px) 10px 22px rgba(230, 197, 106, 0.3);
  }

  .back {
    transform: rotateY(180deg);
    justify-content: flex-start;
    padding: 5.7cqw 7cqw;
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3cqw;
  }

  .row.bottom {
    align-items: flex-end;
  }

  .chip {
    width: 13cqw;
    height: 10.1cqw;
    border-radius: 4px;
    border: 0.5px solid rgba(58, 43, 10, 0.12);
    background: linear-gradient(135deg, #e6cfa1, #d4af37);
  }

  .chip svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgba(58, 43, 10, 0.2);
    stroke-width: 0.8;
  }

  .plane {
    width: 8cqw;
    height: 8cqw;
    fill: rgba(58, 43, 10, 0.55);
  }

  .number {
    font-family: 'Courier New', Courier, monospace;
    font-weight: 700;
    font-size: 5.9cqw;
    letter-spacing: 0.9cqw;
    white-space: nowrap;
    color: rgba(58, 43, 10, 0.8);
    text-shadow: -0.5px -0.5px 0 rgba(255, 255, 255, 0.22);
  }

  .field {
    display: grid;
    gap: 0.6cqw;
    min-width: 0;
  }

  .field.right {
    justify-items: end;
    text-align: right;
  }

  .label {
    font-size: max(7px, 1.9cqw);
    color: #8d6a1f;
    letter-spacing: 0.04em;
  }

  .member {
    font-family: 'Courier New', Courier, monospace;
    font-weight: 700;
    font-size: 4.1cqw;
    letter-spacing: 0.44cqw;
    white-space: nowrap;
  }

  .status {
    font-style: italic;
    font-weight: 900;
    font-size: 2.95cqw;
    white-space: nowrap;
  }

  .back-title {
    font-weight: 900;
    font-size: 4cqw;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .benefits {
    display: grid;
    gap: 1.8cqw;
    margin-top: 3.2cqw;
  }

  .benefit {
    display: grid;
    grid-template-columns: 4.2cqw 1fr;
    gap: 2cqw;
    align-items: start;
    font-size: 3.3cqw;
    font-weight: 700;
    line-height: 1.18;
  }

  .benefit svg {
    width: 4.2cqw;
    height: 4.2cqw;
    margin-top: 0.3cqw;
    fill: #8d6a1f;
  }

  /* Reflet : une bande claire qui glisse avec l'inclinaison */
  .sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      120deg,
      transparent 40%,
      rgba(255, 255, 255, 0.1) 45%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 255, 255, 0.1) 55%,
      transparent 60%
    );
    background-size: 250% 250%;
    background-position: calc(50% - var(--x) * 60%) calc(50% - var(--y) * 40%);
    transition: background-position 0.25s ease-out;
  }

  .bc-hint {
    margin: var(--s-4) 0 0;
    text-align: center;
    font-size: 14px;
    color: var(--c-ink-faint);
  }

  @keyframes peek {
    0%,
    100% {
      transform: rotateY(0deg);
    }
    45% {
      transform: rotateY(-28deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bc-tilt,
    .bc-spin,
    .sheen {
      transition: none;
    }
  }
</style>
