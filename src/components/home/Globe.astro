---
// Illustration du globe des aeroports (onglet Explorer de l'app) : pastilles
// d'aeroports en violet, la pastille du joueur en ambre, des trajectoires.
// Couleurs reprises de l'app (globePinPurple, globePinMe, globeOceanDark).
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<figure class="globe" role="img" aria-label={label}>
  <svg viewBox="0 0 400 400" aria-hidden="true">
    <defs>
      <radialGradient id="globe-ocean" cx="38%" cy="32%" r="75%">
        <stop offset="0%" stop-color="#1d4672"></stop>
        <stop offset="55%" stop-color="#16324f"></stop>
        <stop offset="100%" stop-color="#0b1d33"></stop>
      </radialGradient>
      <clipPath id="globe-clip"><circle cx="200" cy="200" r="168"></circle></clipPath>
    </defs>
    <circle cx="200" cy="200" r="190" fill="none" stroke="rgba(56,182,255,0.12)"></circle>
    <circle cx="200" cy="200" r="168" fill="url(#globe-ocean)"></circle>
    <g clip-path="url(#globe-clip)" fill="none" stroke="rgba(143,214,255,0.16)" stroke-width="1">
      <ellipse cx="200" cy="200" rx="168" ry="56"></ellipse>
      <ellipse cx="200" cy="200" rx="168" ry="112"></ellipse>
      <line x1="32" y1="200" x2="368" y2="200"></line>
      <ellipse cx="200" cy="200" rx="56" ry="168"></ellipse>
      <ellipse cx="200" cy="200" rx="112" ry="168"></ellipse>
      <line x1="200" y1="32" x2="200" y2="368"></line>
    </g>
    <g clip-path="url(#globe-clip)" fill="#2e7d4f" opacity="0.55">
      <path d="M118 118c22-14 52-12 70 2 10 8 4 22-8 26-16 6-14 22-30 26-22 6-40-8-44-26-3-12 2-21 12-28z"></path>
      <path d="M214 96c26-6 58 4 76 22 14 14 6 30-12 32-20 2-26 16-46 14-22-2-34-22-30-40 2-14 4-25 12-28z"></path>
      <path d="M236 206c20-6 44 4 52 22 8 18-4 40-24 48-18 8-36-4-40-22-4-16-4-42 12-48z"></path>
      <path d="M128 222c18-4 34 10 34 28s-10 40-26 44c-16 4-26-12-26-30 0-18 4-38 18-42z"></path>
    </g>
    <g fill="none" stroke="rgba(177,108,234,0.55)" stroke-width="1.4" stroke-dasharray="3 4">
      <path d="M150 146 Q 205 92 262 128"></path>
      <path d="M262 128 Q 300 178 262 240"></path>
      <path d="M150 146 Q 128 200 146 262"></path>
    </g>
    <g fill="#b16cea">
      <circle cx="262" cy="128" r="6"></circle>
      <circle cx="262" cy="240" r="6"></circle>
      <circle cx="146" cy="262" r="6"></circle>
      <circle cx="226" cy="178" r="4"></circle>
      <circle cx="304" cy="196" r="4"></circle>
      <circle cx="112" cy="196" r="4"></circle>
    </g>
    <g>
      <circle cx="150" cy="146" r="16" fill="rgba(255,194,75,0.18)"></circle>
      <circle cx="150" cy="146" r="7" fill="#ffc24b"></circle>
    </g>
  </svg>
</figure>

<style>
  .globe {
    margin: 0;
    width: min(420px, 100%);
    aspect-ratio: 1;
  }

  svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
