---
// Globe des aeroports, comme l'onglet Explorer de l'app : on le fait tourner a la
// souris ou au doigt (fleches au clavier), il tourne lentement au repos.
// Le dessin (src/scripts/globe-runtime.ts) et la carte du monde ne se chargent
// qu'a l'approche de la section, pour ne pas alourdir le haut de la page.
interface Props {
  label: string;
  hint: string;
}

const { label, hint } = Astro.props;
---

<figure class="globe" data-globe>
  <canvas role="img" aria-label={label} aria-describedby="globe-hint" tabindex="0" width="480" height="480"></canvas>
  <figcaption id="globe-hint">{hint}</figcaption>
  <p class="visually-hidden" aria-live="polite" data-globe-live></p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-globe]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const live = root.querySelector<HTMLElement>('[data-globe-live]')!;
    const lang = document.documentElement.lang === 'en' ? 'en' : 'fr';
    let mounted = false;
    const mount = () => {
      if (mounted) return;
      mounted = true;
      import('../../scripts/globe-runtime')
        .then(({ mountGlobe }) => {
          mountGlobe(canvas, { reduce, lang, onSelect: (label) => (live.textContent = label || '') });
          root.classList.add('ready');
        })
        .catch(() => root.classList.add('failed'));
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            mount();
          }
        },
        { rootMargin: '400px 0px' },
      );
      io.observe(root);
    } else {
      mount();
    }
  });
</script>

<style>
  .globe {
    margin: 0;
    width: min(500px, 100%);
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: var(--s-3);
  }

  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    cursor: grab;
    /* Le doigt fait tourner le globe a l'horizontale, la page defile a la verticale. */
    touch-action: pan-y;
    border-radius: 50%;
    /* Silhouette du globe tant que le dessin n'est pas charge. */
    background: radial-gradient(circle at 50% 50%, #16324f 0 39%, rgba(56, 182, 255, 0.14) 40%, transparent 48%);
    transition: background 0.3s ease;
  }

  .ready canvas {
    background: none;
  }

  canvas:global(.on-pin) {
    cursor: pointer;
  }

  canvas:global(.grabbing) {
    cursor: grabbing;
  }

  canvas:focus-visible {
    outline-offset: -8px;
  }

  figcaption {
    font-size: 14px;
    color: var(--c-ink-faint);
    text-align: center;
  }

  .failed figcaption {
    display: none;
  }
</style>
