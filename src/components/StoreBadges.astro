---
// Badges officiels des stores (memes visuels que l'ancien site).
import { STORE_LINKS } from '../data/site';

interface Props {
  size?: 'large' | 'small';
}

const { size = 'large' } = Astro.props;
---

<div class:list={['badges', size]}>
  <a class="badge" href={STORE_LINKS.ios} rel="noopener" aria-label="Download on the App Store">
    <svg class="logo" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.365 1.43c0 1.14-.414 2.198-1.104 2.983-.789.9-2.074 1.595-3.19 1.51-.141-1.109.446-2.295 1.127-3.042.751-.833 2.057-1.43 3.167-1.451zM20.678 17.156c-.565 1.258-.836 1.818-1.563 2.924-1.014 1.544-2.445 3.468-4.22 3.483-1.58.014-1.987-1.03-4.132-1.017-2.146.013-2.594 1.036-4.174 1.022-1.775-.016-3.13-1.75-4.143-3.293-2.834-4.321-3.134-9.389-1.381-12.08 1.246-1.91 3.21-3.028 5.056-3.028 1.88 0 3.062 1.03 4.616 1.03 1.507 0 2.425-1.033 4.601-1.033 1.645 0 3.389.895 4.634 2.438-4.068 2.23-3.406 8.028.706 9.554z"
      ></path>
    </svg>
    <span class="copy"><span class="small-line">Download on the</span><span class="big-line">App Store</span></span>
  </a>
  <a class="badge" href={STORE_LINKS.android} rel="noopener" aria-label="Get it on Google Play">
    <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
      <path fill="#34A853" d="M11.7 8.8c-.87.93-1.37 2.28-1.37 3.99v38.42c0 1.7.5 3.06 1.37 3.99L37.24 32 11.7 8.8z"></path>
      <path fill="#4285F4" d="M11.7 8.8 43.16 26.8 37.24 32 11.7 8.8z"></path>
      <path fill="#FBBC04" d="M50.97 31.2c1.83 1.03 1.83 2.58 0 3.62l-7.81 4.46L37.24 32l5.92-5.2 7.81 4.4z"></path>
      <path fill="#EA4335" d="M11.7 55.2 37.24 32l5.92 7.18L11.7 55.2z"></path>
    </svg>
    <span class="copy"><span class="small-line upper">Get it on</span><span class="big-line">Google Play</span></span>
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    min-width: 180px;
    padding: 0 18px 0 14px;
    border: 1px solid #a6aeb9;
    border-radius: 12px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .badge:hover {
    color: #fff;
    border-color: #fff;
    transform: translateY(-1px);
  }

  .logo {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .small-line {
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .small-line.upper {
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .big-line {
    font-size: 21px;
    font-weight: 500;
    white-space: nowrap;
  }

  .small .badge {
    height: 48px;
    min-width: 156px;
  }

  .small .big-line {
    font-size: 18px;
  }

  @media (max-width: 420px) {
    .badges {
      flex-direction: column;
    }

    .badge {
      width: 100%;
      justify-content: center;
    }
  }
</style>
